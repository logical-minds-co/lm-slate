{
  "name": "slate",
  "version": "0.1.0",
  "description": "A hyper-focus workspace. Each tab is a terminal or a browser. Ink on glass.",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "node scripts/build.mjs && electron .",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-rebuild -f -w node-pty",
    "icon": "electron scripts/icon.cjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
